# Copy to .env and fill in your key. NEVER commit .env.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Loop caps
MAX_STEPS=8
MAX_SPEND_USD=0.50
MAX_SUPPRESSED_DUPLICATES=3

# Optional: override token prices used for the spend estimate (USD per token)
# PRICE_INPUT_PER_TOKEN=0.000003
# PRICE_OUTPUT_PER_TOKEN=0.000015
